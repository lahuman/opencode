+
+test("sidecar startup transfers and releases the provider catalog and credentials", () => {
+  const catalog = {
+    schemaVersion: 1 as const,
+    default: { providerID: "internal", modelID: "code" },
+    providers: [
+      {
+        id: "internal",
+        name: "Internal",
