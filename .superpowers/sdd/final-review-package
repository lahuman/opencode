#!/usr/bin/env bash
set -euo pipefail

files=()
while IFS= read -r -d '' entry; do
  path=${entry:3}
  case "$path" in
    .superpowers/* | docs/superpowers/plans/2026-07-20-task-5-remediation.md) continue ;;
  esac
  files+=("$path")
done < <(git status --porcelain=v1 -z)

.superpowers/sdd/review-working-tree .superpowers/sdd/final-review.diff "${files[@]}"
