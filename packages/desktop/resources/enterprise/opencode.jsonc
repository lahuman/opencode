{
  "enabled_providers": ["company-llm"],
  "provider": {
    "company-llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Company LLM",
      "models": {}
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask"
    }
  }
}
